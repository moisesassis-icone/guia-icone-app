{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.22.0"
    },
    "simulador": {
      "extends": "base",
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "URL_DO_GUIA": "https://teste.guiaicone.com" }
    },
    "teste": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "env": { "URL_DO_GUIA": "https://teste.guiaicone.com" }
    },
    "producao": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "env": { "URL_DO_GUIA": "https://guiaicone.com" }
    }
  },
  "submit": {
    "teste": {
      "ios": { "ascAppId": "PREENCHER_COM_O_ID_DO_APP_NO_APP_STORE_CONNECT" }
    },
    "producao": {
      "ios": { "ascAppId": "PREENCHER_COM_O_ID_DO_APP_NO_APP_STORE_CONNECT" }
    }
  }
}
